<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestion_RDV.Views.Medecins.MedecinFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Gestion_RDV.ViewModels.Medecins"
    Title="Médecin"
    BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- En-tête -->
            <VerticalStackLayout Spacing="10">                  
                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Nouveau Médecin"  
                    TextColor="White" />

                <BoxView
                    HeightRequest="3"
                    BackgroundColor="#2563EB"
                    WidthRequest="60"
                    HorizontalOptions="Start"
                    CornerRadius="2" />
            </VerticalStackLayout>

            <!-- Icône du médecin -->
            <Border
                BackgroundColor="#2563EB"
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeThickness="0"
                WidthRequest="100"
                Margin="0,10,0,20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50" />
                </Border.StrokeShape>

                <Label
                    FontSize="50"
                    HorizontalOptions="Center"
                    Text="🩺"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <!-- Formulaire -->
            <Frame
                BackgroundColor="#1E293B"
                BorderColor="Transparent"
                CornerRadius="15"
                HasShadow="False"
                Padding="20">

                <VerticalStackLayout Spacing="20">

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Informations personnelles"
                        TextColor="White" />

                    <!-- Nom -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontSize="14"
                            Text="Nom *"
                            TextColor="#94A3B8" />
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Entry
                                Placeholder="Ex: Leblanc"
                                PlaceholderColor="#64748B"
                                Text="{Binding LastName}"
                                TextColor="White" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Prénom -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontSize="14"
                            Text="Prénom *"
                            TextColor="#94A3B8" />
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Entry
                                Placeholder="Ex: Jean"
                                PlaceholderColor="#64748B"
                                Text="{Binding FirstName}"
                                TextColor="White" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Spécialité -->
                    <VerticalStackLayout Spacing="8">
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                Title="Spécialité *"
                                SelectedItem="{Binding Specialite}"
                                TextColor="White"
                                TitleColor="#94A3B8">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Médecin généraliste</x:String>
                                        <x:String>Cardiologue</x:String>
                                        <x:String>Dermatologue</x:String>
                                        <x:String>Pédiatre</x:String>
                                        <x:String>Gynécologue</x:String>
                                        <x:String>Ophtalmologue</x:String>
                                        <x:String>Psychiatre</x:String>
                                        <x:String>Chirurgien</x:String>
                                        <x:String>Autre</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontSize="14"
                            Text="Email"
                            TextColor="#94A3B8" />
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Entry
                                Placeholder="email@exemple.fr"
                                PlaceholderColor="#64748B"
                                Text="{Binding Email}"
                                Keyboard="Email"
                                TextColor="White" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Téléphone -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontSize="14"
                            Text="Téléphone"
                            TextColor="#94A3B8" />
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Entry
                                Placeholder="01 23 45 67 89"
                                PlaceholderColor="#64748B"
                                Text="{Binding Phone}"
                                Keyboard="Telephone"
                                TextColor="White" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Boutons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button
                            Grid.Column="0"
                            Text="Annuler"
                            BackgroundColor="#475569"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding CancelCommand}" />

                        <Button
                            Grid.Column="1"
                            Text="Enregistrer"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding SaveCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
