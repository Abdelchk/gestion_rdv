<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestion_RDV.Views.RendezVous.AppointmentListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Gestion_RDV.ViewModels.RendezVous"
    xmlns:models="clr-namespace:Gestion_RDV.Models"
    Title="Rendez-vous"
    BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <!-- En-tête -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Gestion des Rendez-vous"
                    TextColor="White"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    BackgroundColor="#2563EB"
                    Command="{Binding AddAppointmentCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Padding="20,10"
                    Text="+ Nouveau Rendez-vous"
                    TextColor="White" />
            </Grid>

            <Label
                FontSize="14"
                Text="{Binding FilteredAppointments.Count, StringFormat='{0} rendez-vous'}"
                TextColor="#94A3B8" />
        </VerticalStackLayout>

        <!-- Filtres -->
        <Frame
            Grid.Row="1"
            Margin="0,20,0,0"
            BackgroundColor="#F8FAFC"
            BorderColor="Transparent"
            CornerRadius="10"
            HasShadow="False"
            Padding="20">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="15">

                <!-- Titre Filtres -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label
                        Grid.Column="0"
                        FontSize="16"
                        Text="🔍"
                        TextColor="#94A3B8"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="Filtres"
                        TextColor="#1E293B"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="2"
                        BackgroundColor="#334155"
                        Command="{Binding ClearFiltersCommand}"
                        CornerRadius="6"
                        FontSize="11"
                        Padding="12,6"
                        Text="Réinitialiser"
                        TextColor="White" />
                </Grid>

                <!-- Filtres -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="15">

                    <!-- Type -->
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label
                            FontSize="12"
                            Text="Type"
                            TextColor="#475569" />
                        <Frame
                            BackgroundColor="#F8FAFC"
                            BorderColor="#E2E8F0"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                Title="Tous les types"
                                SelectedItem="{Binding SelectedType}"
                                TextColor="#1E293B">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type models:AppointmentType}">
                                        <models:AppointmentType>Consultation</models:AppointmentType>
                                        <models:AppointmentType>Controle</models:AppointmentType>
                                        <models:AppointmentType>Urgence</models:AppointmentType>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Statut -->
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label
                            FontSize="12"
                            Text="Statut"
                            TextColor="#475569" />
                        <Frame
                            BackgroundColor="#F8FAFC"
                            BorderColor="#E2E8F0"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                Title="Tous les statuts"
                                SelectedItem="{Binding SelectedStatus}"
                                TextColor="#1E293B">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type models:AppointmentStatus}">
                                        <models:AppointmentStatus>Normal</models:AppointmentStatus>
                                        <models:AppointmentStatus>Urgent</models:AppointmentStatus>
                                        <models:AppointmentStatus>Cancelled</models:AppointmentStatus>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Médecin -->
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label
                            FontSize="12"
                            Text="Médecin"
                            TextColor="#475569" />
                        <Frame
                            BackgroundColor="#F8FAFC"
                            BorderColor="#E2E8F0"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                Title="Tous les médecins"
                                ItemsSource="{Binding Medecins}"
                                ItemDisplayBinding="{Binding FullName}"
                                SelectedIndex="-1"
                                TextColor="#1E293B"
                                SelectedIndexChanged="OnMedecinFilterChanged" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Date -->
                    <VerticalStackLayout Grid.Column="3" Spacing="8">
                        <Label
                            FontSize="12"
                            Text="Date"
                            TextColor="#475569" />
                        <Frame
                            BackgroundColor="#F8FAFC"
                            BorderColor="#E2E8F0"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <DatePicker
                                Date="{Binding SelectedDate}"
                                TextColor="#1E293B"
                                Format="dd/MM/yyyy" />
                        </Frame>
                    </VerticalStackLayout>

                </Grid>
            </Grid>
        </Frame>

        <!-- Liste des rendez-vous -->
        <RefreshView
            Grid.Row="2"
            Margin="0,20,0,0"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}">

            <CollectionView ItemsSource="{Binding FilteredAppointments}">

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Frame
                            BackgroundColor="#F8FAFC"
                            BorderColor="Transparent"
                            CornerRadius="10"
                            HasShadow="False"
                            Padding="15,10"
                            Margin="0,10,0,5">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontSize="18"
                                    Text="📅"
                                    TextColor="#2563EB"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Date}"
                                    TextColor="#1E293B"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    FontSize="12"
                                    Text="{Binding Count, StringFormat='{0} rendez-vous'}"
                                    TextColor="#94A3B8"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="0,5"
                            BackgroundColor="#F8FAFC"
                            BorderColor="{Binding BorderColor}"
                            CornerRadius="10"
                            Padding="20">

                            <Grid ColumnDefinitions="4,Auto,*,Auto,Auto" ColumnSpacing="15">

                                <!-- Barre colorée de statut -->
                                <BoxView
                                    Grid.Column="0"
                                    BackgroundColor="{Binding BorderColor}"
                                    WidthRequest="4"
                                    CornerRadius="2" />

                                <!-- Icône Patient -->
                                <Border
                                    Grid.Column="1"
                                    BackgroundColor="{Binding BorderColor}"
                                    HeightRequest="50"
                                    WidthRequest="50"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="25" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontSize="24"
                                        HorizontalOptions="Center"
                                        Text="👤"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Border>

                                <!-- Informations du RDV -->
                                <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">

                                    <!-- Patient -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="14"
                                            Text="👤"
                                            TextColor="#60A5FA"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding PatientName}"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            TextColor="#1E293B"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Médecin et Type -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="12"
                                            Text="🩺"
                                            TextColor="#94A3B8"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding MedecinName}"
                                            FontSize="13"
                                            TextColor="#64748B"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="2"
                                            Text=" • "
                                            FontSize="13"
                                            TextColor="#64748B"
                                            VerticalOptions="Center" />
                                        <Frame
                                            Grid.Column="3"
                                            BackgroundColor="{Binding BorderColor}"
                                            Padding="8,3"
                                            CornerRadius="6"
                                            HasShadow="False">
                                            <Label
                                                Text="{Binding TypeLabel}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="White" />
                                        </Frame>
                                    </Grid>

                                    <!-- Notes -->
                                    <Label
                                        Text="{Binding Notes}"
                                        FontSize="12"
                                        TextColor="#64748B"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1" />
                                </VerticalStackLayout>

                                <!-- Heure et Statut -->
                                <VerticalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                                        <Label
                                            Grid.Column="0"
                                            FontSize="14"
                                            Text="⏰"
                                            TextColor="#94A3B8"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Time}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="#1E293B"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Frame
                                        BackgroundColor="{Binding BorderColor}"
                                        Padding="10,5"
                                        CornerRadius="6"
                                        HasShadow="False">
                                        <Label
                                            Text="{Binding StatusLabel}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            HorizontalOptions="Center" />
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Actions -->
                                <HorizontalStackLayout Grid.Column="4" Spacing="10" VerticalOptions="Center">
                                    <Button
                                        BackgroundColor="#3B82F6"
                                        BorderWidth="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentListViewModel}}, Path=EditAppointmentCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="6"
                                        FontSize="14"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        Text="✏️"
                                        TextColor="White"
                                        WidthRequest="32" />

                                    <Button
                                        BackgroundColor="#EF4444"
                                        BorderWidth="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentListViewModel}}, Path=DeleteAppointmentCommand}"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="6"
                                        FontSize="14"
                                        HeightRequest="32"
                                        Padding="12,0"
                                        Text="🗑️"
                                        TextColor="White"
                                        WidthRequest="32" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="40"
                        Spacing="15"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            FontSize="60"
                            HorizontalOptions="Center"
                            Text="📅"
                            TextColor="#475569" />
                        <Label
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="Aucun rendez-vous"
                            TextColor="#64748B" />
                        <Label
                            FontSize="14"
                            HorizontalOptions="Center"
                            Text="Utilisez les filtres pour affiner votre recherche"
                            TextColor="#64748B" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
