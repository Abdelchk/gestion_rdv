<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Gestion_RDV.Views.RendezVous.AppointmentFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Gestion_RDV.ViewModels.RendezVous"
    xmlns:models="clr-namespace:Gestion_RDV.Models"
    Title="Rendez-vous"
    BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- En-tête -->
            <VerticalStackLayout Spacing="10">
                <Label
                    x:Name="TitleLabel"
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="Nouveau Rendez-vous"
                    TextColor="White" />

                <BoxView
                    HeightRequest="3"
                    BackgroundColor="#2563EB"
                    WidthRequest="60"
                    HorizontalOptions="Start"
                    CornerRadius="2" />
            </VerticalStackLayout>

            <!-- Icône -->
            <Border
                BackgroundColor="#2563EB"
                HeightRequest="100"
                HorizontalOptions="Center"
                StrokeThickness="0"
                WidthRequest="100"
                Margin="0,10,0,20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50" />
                </Border.StrokeShape>

                <Label
                    FontSize="50"
                    HorizontalOptions="Center"
                    Text="📅"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Border>

            <!-- Formulaire -->
            <Frame
                BackgroundColor="#1E293B"
                BorderColor="Transparent"
                CornerRadius="15"
                HasShadow="False"
                Padding="20">

                <VerticalStackLayout Spacing="20">

                    <!-- Patient -->
                    <VerticalStackLayout Spacing="8">
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                ItemsSource="{Binding Patients}"
                                ItemDisplayBinding="{Binding FullName}"
                                SelectedItem="{Binding SelectedPatient}"
                                Title="Patient *"
                                TextColor="White"
                                TitleColor="#94A3B8" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Médecin -->
                    <VerticalStackLayout Spacing="8">
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                ItemsSource="{Binding Medecins}"
                                ItemDisplayBinding="{Binding FullName}"
                                SelectedItem="{Binding SelectedMedecin}"
                                Title="Médecin *"
                                TextColor="White"
                                TitleColor="#94A3B8" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Date et Heure -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                        <!-- Date -->
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label
                                FontSize="14"
                                Text="Date *"
                                TextColor="#94A3B8" />
                            <Frame
                                BackgroundColor="#0F172A"
                                BorderColor="#334155"
                                CornerRadius="8"
                                HasShadow="False"
                                Padding="0">
                                <DatePicker
                                    Date="{Binding Date}"
                                    Format="dd/MM/yyyy"
                                    TextColor="White" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Heure -->
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label
                                FontSize="14"
                                Text="Heure *"
                                TextColor="#94A3B8" />
                            <Frame
                                BackgroundColor="#0F172A"
                                BorderColor="#334155"
                                CornerRadius="8"
                                HasShadow="False"
                                Padding="0">
                                <TimePicker
                                    Time="{Binding Time}"
                                    TextColor="White" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Type -->
                    <VerticalStackLayout Spacing="8">
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                SelectedItem="{Binding Type}"
                                Title="Type de rendez-vous *"
                                TextColor="White"
                                TitleColor="#94A3B8">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type models:AppointmentType}">
                                        <models:AppointmentType>Consultation</models:AppointmentType>
                                        <models:AppointmentType>Controle</models:AppointmentType>
                                        <models:AppointmentType>Urgence</models:AppointmentType>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Statut -->
                    <VerticalStackLayout Spacing="8">
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Picker
                                SelectedItem="{Binding Status}"
                                Title="Statut *"
                                TextColor="White"
                                TitleColor="#94A3B8">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type models:AppointmentStatus}">
                                        <models:AppointmentStatus>Normal</models:AppointmentStatus>
                                        <models:AppointmentStatus>Urgent</models:AppointmentStatus>
                                        <models:AppointmentStatus>Cancelled</models:AppointmentStatus>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontSize="14"
                            Text="Notes"
                            TextColor="#94A3B8" />
                        <Frame
                            BackgroundColor="#0F172A"
                            BorderColor="#334155"
                            CornerRadius="8"
                            HasShadow="False"
                            Padding="0">
                            <Editor
                                Placeholder="Notes additionnelles..."
                                PlaceholderColor="#64748B"
                                Text="{Binding Notes}"
                                TextColor="White"
                                HeightRequest="100"
                                AutoSize="TextChanges" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Boutons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button
                            Grid.Column="0"
                            Text="Annuler"
                            BackgroundColor="#475569"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding CancelCommand}" />

                        <Button
                            Grid.Column="1"
                            Text="Enregistrer"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="8"
                            Command="{Binding SaveCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
