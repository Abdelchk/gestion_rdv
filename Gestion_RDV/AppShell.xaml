<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Gestion_RDV.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:patients="clr-namespace:Gestion_RDV.Views.Patients"
    xmlns:medecins="clr-namespace:Gestion_RDV.Views.Medecins"
    xmlns:rdv="clr-namespace:Gestion_RDV.Views.RendezVous"
    xmlns:dashboard="clr-namespace:Gestion_RDV.Views.Dashboard"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#1E293B"
    Shell.TabBarTitleColor="#1E293B"
    Shell.TabBarUnselectedColor="#64748B">

    <TabBar>

        <Tab Title="📊 Tableau de Bord" Route="dashboard">
            <ShellContent ContentTemplate="{DataTemplate dashboard:DashboardPage}" />
        </Tab>

        <Tab Title="👥 Patients" Route="patients">
            <ShellContent ContentTemplate="{DataTemplate patients:PatientListPage}" />
        </Tab>

        <Tab Title="🩺 Médecins" Route="medecins">
            <ShellContent ContentTemplate="{DataTemplate medecins:MedecinListPage}" />
        </Tab>

        <Tab Title="📅 Rendez-vous" Route="rendezvous">
            <ShellContent ContentTemplate="{DataTemplate rdv:AppointmentListPage}" />
        </Tab>

    </TabBar>

</Shell>
